Dux {
  initialState {
    cells: [] // Array of live cell coordinates [{x, y}]
    generation: 0
    bounds: { width: 60, height: 60 }
    isRunning: false
    speed: 5 // 1-10 steps per second
    mode: 'classic' // 'classic' | 'lifeGarden' | 'puzzle'
    birthCandidates: [] // Valid birth positions in placement modes
    goalTiles: [] // Goal tile coordinates for challenge maps
    obstacles: [] // Inert puzzle tiles that cannot be occupied
    seedLimit: 0 // Total birth resources for a puzzle run
    seedsRemaining: 0 // Remaining birth resources in puzzle mode
    puzzleId: null // Active puzzle map identifier
    puzzleIndex: 0 // Active puzzle position in ordered sequence
    puzzleCount: 0 // Total number of puzzles in sequence
    puzzleCampaignComplete: false // Terminal progression state
    runState: 'active' // 'active' | 'won'
  }

  slice: "grid"

  actions {
    setGrid(payload: { cells, bounds?, mode?, goalTiles?, obstacles?, seedLimit?, seedsRemaining?, runState? })
    stepGrid()
    clearGrid()
    resetGrid(payload: { bounds?, puzzleId?, goalTiles? })
    toggleRunning()
    setCells(payload: { cells })
    loadPattern(payload: { pattern })
    loadPatternFromLibrary(payload: { name })
    setSpeed(payload: { speed })
    setMode(payload: { mode })
    applyPlayerBirth(payload: { cell })
    setGoalTiles(payload: { goalTiles })
    confirmPuzzleVictory()
  }

  selectors {
    getGrid: state => state[slice]
    getCells: state => state[slice].cells
    getGeneration: state => state[slice].generation
    getBounds: state => state[slice].bounds
    getIsRunning: state => state[slice].isRunning
    getSpeed: state => state[slice].speed
    getMode: state => state[slice].mode
    getBirthCandidates: state => state[slice].birthCandidates
    getGoalTiles: state => state[slice].goalTiles
    getObstacles: state => state[slice].obstacles
    getSeedLimit: state => state[slice].seedLimit
    getSeedsRemaining: state => state[slice].seedsRemaining
    getPuzzleIndex: state => state[slice].puzzleIndex
    getPuzzleCount: state => state[slice].puzzleCount
    getIsPuzzleCampaignComplete: state => state[slice].puzzleCampaignComplete
    getRunState: state => state[slice].runState
  }

  requirements [
    "Given an initial state, should have empty cells and generation 0"
    "Given setGrid action with cells, should update cells in state"
    "Given stepGrid action, should increment generation"
    "Given clearGrid action, should set cells to empty array"
    "Given resetGrid action, should reset generation to 0 and optionally update bounds"
    "Given toggleRunning action, should toggle isRunning boolean"
    "Given setCells action, should update cells without changing generation"
    "Given loadPattern action with JSON, should deserialize and load pattern into state"
    "Given loadPatternFromLibrary action with pattern name, should load that pattern from library"
  ]
}
